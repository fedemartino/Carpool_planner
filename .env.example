# Auth0 credentials
# Obtain these from your Auth0 dashboard: https://manage.auth0.com
#   1. Create an Application of type "Single Page Application"
#   2. Set Allowed Callback URLs, Allowed Logout URLs, and Allowed Web Origins
#      to your deployment URL (e.g. http://localhost for local Docker testing)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your_client_id_here
